# Read by packaging/release/gate.sh before this chart is released: each image the chart's values pin, and the identity
# of the release workflow (with its tag prefix; the image tag completes it) whose keyless signature the image must carry.
IMAGE_SIGNERS=(
  "ghcr.io/aient-ai/kubernetes-connector=https://github.com/haf/glimt/.github/workflows/kube-connector-release.yml@refs/tags/kube-connector-v"
)
